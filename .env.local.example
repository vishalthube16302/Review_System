NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Free-tier AI provider for personalized review generation (https://console.groq.com)
# If unset or both models fail, drafts are built offline from the customer's own
# taps/note (logged as an error so you notice).
GROQ_API_KEY=your_groq_api_key
# Optional overrides - Groq retires models regularly (llama-3.3-70b was shut down
# 16 Aug 2026). See https://console.groq.com/docs/deprecations
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
