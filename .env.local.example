NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Free-tier AI provider for personalized review generation (https://console.groq.com)
# If unset or the API call fails/times out, the app silently falls back to
# static templates from the review_templates table - the customer flow never breaks.
GROQ_API_KEY=your_groq_api_key
